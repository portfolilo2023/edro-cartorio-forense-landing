href="https://portfolilo2023.github.io/edro-cartorio-forense-mvp/"
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EDRO | Cartório Forense™ — MVP</title>
  <style>
    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:0;background:#0c1220;color:#e6e8ee}
    .container{max-width:1100px;margin:0 auto;padding:24px}
    header{display:flex;align-items:center;gap:12px;border-bottom:1px solid #1f2a44;margin-bottom:18px;padding-bottom:12px}
    .logo{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#5eead4,#56c2d6);display:grid;place-items:center;color:#0b1323;font-weight:800}
    .tabs{display:flex;gap:8px;margin-bottom:12px}
    .tab-btn{background:#0f172a;border:1px solid #1f2a44;color:#e6e8ee;padding:10px 14px;border-radius:999px;cursor:pointer;font-weight:600}
    .tab-btn.active{border-color:#5eead4;box-shadow:0 0 0 2px rgba(94,234,212,.2) inset}
    .card{background:#0f172a;border:1px solid #1f2a44;border-radius:16px;padding:16px}
    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}
    .col-12{grid-column:span 12}.col-8{grid-column:span 8}.col-6{grid-column:span 6}.col-4{grid-column:span 4}
    label{font-size:.9rem;color:#98a2b3} input,select{background:#0b1323;border:1px solid #1f2a44;color:#e6e8ee;padding:12px;border-radius:10px;width:100%}
    .btn{background:linear-gradient(135deg,#5eead4,#56c2d6);color:#0b1323;border:none;padding:12px 16px;border-radius:12px;font-weight:800;cursor:pointer}
    .kpi-wrap{display:grid;gap:12px;grid-template-columns:repeat(3,1fr)} .kpi{border:1px solid #1f2a44;border-radius:14px;padding:14px;background:#0b1323}
    .muted{color:#98a2b3}.footer{margin-top:18px;color:#98a2b3}
    @media (max-width:900px){.col-8,.col-6,.col-4{grid-column:span 12}.kpi-wrap{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="container">
  <header>
    <div class="logo">E</div>
    <div>
      <h1 style="margin:0;font-size:1.25rem">EDRO | Cartório Forense™ — MVP</h1>
      <div class="muted">Demonstração: Modelagem Financeira e Execução Extrajudicial</div>
    </div>
  </header>

  <div class="tabs">
    <button class="tab-btn active" data-tab="sim">Simulador & Validador</button>
    <button class="tab-btn" data-tab="rep">Relatório (preview)</button>
    <button class="tab-btn" data-tab="sob">Sobre</button>
  </div>

  <section id="sim" class="card">
    <div class="grid">
      <div class="col-8"><label>Valor do Contrato (R$)</label><input id="P" type="number" value="300000"/></div>
      <div class="col-4"><label>Prazo (meses)</label><input id="N" type="number" value="360"/></div>
      <div class="col-4"><label>Taxa nominal (% a.a.)</label><input id="IAA" type="number" step="0.0001" value="8.5"/></div>
      <div class="col-4"><label>TR (% m.m.)</label><input id="TR" type="number" step="0.0001" value="0.05"/></div>
      <div class="col-4"><label>Bonificação (% a.a.)</label><input id="BON" type="number" step="0.0001" value="2.0"/></div>
      <div class="col-6"><label>Sistema</label><select id="SYS"><option>PRICE</option><option>SAC</option></select></div>
      <div class="col-6" style="display:flex;align-items:end;justify-content:end;gap:8px">
        <button class="btn" id="calc">Calcular</button>
        <button class="btn" id="ex">Exemplo (Maria L.)</button>
      </div>
    </div>

    <div style="height:10px"></div>
    <div class="kpi-wrap">
      <div class="kpi"><div class="muted">Parcela Banco</div><div id="k1" style="font-weight:800;font-size:1.3rem">—</div></div>
      <div class="kpi"><div class="muted">Parcela Forense</div><div id="k2" style="font-weight:800;font-size:1.3rem">—</div></div>
      <div class="kpi"><div class="muted">Diferença</div><div id="k3" style="font-weight:800;font-size:1.3rem">—</div></div>
    </div>

    <div style="height:10px"></div>
    <div id="sum" class="muted">Insira os parâmetros e clique em “Calcular”.</div>
  </section>

  <section id="rep" class="card" style="display:none">
    <h3 style="margin:0 0 8px 0">Relatório Forense — Prévia</h3>
    <button class="btn" id="mk">Gerar Preview</button>
    <div id="repOut" style="margin-top:12px;border:1px solid #1f2a44;border-radius:12px;padding:12px;background:#0b1323"></div>
  </section>

  <section id="sob" class="card" style="display:none">
    <h3 style="margin:0 0 8px 0">Sobre</h3>
    <p>Protótipo demonstrativo do <strong>EDRO | Cartório Forense™</strong>. Calcula parcelas com e sem bonificação e TR, compara e gera um preview textual do relatório. A versão final incluirá memória de cálculo auditável, assinatura ICP-Brasil e integração SERP/CNJ.</p>
  </section>

  <div class="footer">© <span id="yr"></span> EDRO — Protótipo demonstrativo</div>
</div>

<script>
const $=id=>document.getElementById(id);
const fmt=v=>isFinite(v)?v.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}):'—';
const pct=v=>isFinite(v)?(v*100).toFixed(2)+'%':'—';
$('yr').textContent=new Date().getFullYear();

document.querySelectorAll('.tab-btn').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
  b.classList.add('active');
  ['sim','rep','sob'].forEach(id=>$(id).style.display = (b.dataset.tab===id)?'':'none');
});

function aa_to_am(iaa){return Math.pow(1+iaa,1/12)-1;}
function price_pmt(P,i,n){return i===0?P/n: P*i/(1-Math.pow(1+i,-n));}
function sac_first(P,i,n){const A=P/n; return A + P*i;}

function calc(){
  const P=parseFloat($('P').value||'0'), N=parseInt($('N').value||'0');
  const IAA=parseFloat($('IAA').value||'0')/100, TR=parseFloat($('TR').value||'0')/100;
  const BON=parseFloat($('BON').value||'0')/100, SYS=$('SYS').value;
  const im_bank=aa_to_am(IAA)+TR;
  const im_for=aa_to_am(Math.max(IAA-BON,0))+TR;
  let pb=0,pf=0;
  if(SYS==='PRICE'){ pb=price_pmt(P,im_bank,N); pf=price_pmt(P,im_for,N); }
  else { pb=sac_first(P,im_bank,N); pf=sac_first(P,im_for,N); }
  const delta=pb-pf;
  $('k1').textContent=fmt(pb);
  $('k2').textContent=fmt(pf);
  $('k3').textContent=fmt(delta);
  $('sum').textContent=`Sistema ${SYS} • i_m banco: ${pct(im_bank)} • i_m forense: ${pct(im_for)} • Diferença por parcela: ${fmt(delta)} (demonstrativo).`;
  window.__state={P,N,IAA,TR,BON,SYS,im_bank,im_for,pb,pf,delta};
}
$('calc').onclick=calc;
$('ex').onclick=()=>{$('P').value=280000; $('N').value=338; $('IAA').value=9.2; $('TR').value=0.03; $('BON').value=2.5; $('SYS').value='PRICE'; calc();};
$('mk').onclick=()=>{
  const s=window.__state||{};
  $('repOut').innerHTML=`
    <h4 style="margin:0 0 6px 0">Relatório — Prévia</h4>
    <p><strong>Parâmetros</strong><br/>
    Principal: ${fmt(s.P)} • n: ${s.N||'—'} • Sistema: ${s.SYS||'—'}<br/>
    i_m Banco: ${pct(s.im_bank||0)} • i_m Forense: ${pct(s.im_for||0)}</p>
    <table style="width:100%;border-collapse:collapse">
      <tr><th style="text-align:left;border-bottom:1px solid #1f2a44;padding:8px">Parcela Banco</th>
          <th style="text-align:left;border-bottom:1px solid #1f2a44;padding:8px">Parcela Forense</th>
          <th style="text-align:left;border-bottom:1px solid #1f2a44;padding:8px">Diferença</th></tr>
      <tr><td style="padding:8px">${fmt(s.pb)}</td><td style="padding:8px">${fmt(s.pf)}</td><td style="padding:8px">${fmt(s.delta)}</td></tr>
    </table>
    <p style="color:#98a2b3">Prévia demonstrativa. A versão oficial incluirá memória de cálculo detalhada, base normativa (Lei 9.514/97, Res. CMN 4.676/2018, CDC), assinatura digital ICP-Brasil e QR Code EDRO Ledger™.</p>
  `;
};
</script>
</body>
</html>
